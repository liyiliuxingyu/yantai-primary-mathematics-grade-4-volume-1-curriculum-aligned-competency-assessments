{
  "units": [
    {
      "unit": "一 四则混合运算",
      "deck_indices": "1—7",
      "locations": "教材印刷1—12；教参PDF13—41",
      "methods": "整数加减乘除、运算顺序、小/中括号；用条件分析和问题分析列综合式；互不依赖的乘除可同一步完成。"
    },
    {
      "unit": "二 相交与平行",
      "deck_indices": "8—12",
      "locations": "教材印刷13—22；教参PDF42—54",
      "methods": "同一平面平行/相交/垂直；用三角板、直尺等作垂线和平行线；点到直线距离为垂线段长度，平行线间距离相等。"
    },
    {
      "unit": "三 解决问题",
      "deck_indices": "13—21",
      "locations": "教材印刷23—36；教参PDF55—84",
      "methods": "单价×数量＝总价，速度×时间＝路程；一般行程、同时相向而行相遇；用线段图分析，先统一单位。"
    },
    {
      "unit": "四 运算律",
      "deck_indices": "22—28",
      "locations": "教材印刷42—56；教参PDF97—125",
      "methods": "加法交换律、结合律；乘法交换律、结合律、分配律；连减性质a-b-c=a-(b+c)、连除性质a÷b÷c=a÷(b×c)；拆数、凑整、补偿。"
    },
    {
      "unit": "五 多边形",
      "deck_indices": "29—36",
      "locations": "教材印刷57—73；教参PDF126—160",
      "methods": "三角形稳定性、按角和按边分类、底高、尺规作等边三角形；任意两边和大于第三边、内角和180°；平行四边形/梯形与特殊四边形关系。"
    },
    {
      "unit": "六 小数意义性质",
      "deck_indices": "37—48",
      "locations": "教材印刷74—95；教参PDF161—197",
      "methods": "小数意义、数位计数单位、读写比较、末尾添去0、点位移动、名数换算、四舍五入和万/亿改写。"
    },
    {
      "unit": "七 小数加减",
      "deck_indices": "49—53",
      "locations": "教材印刷96—104；教参PDF198—212",
      "methods": "小数点与相同数位对齐，必要时末尾补0；小数加减混合、加法运算律及减法性质推广、补偿凑整。"
    },
    {
      "unit": "八 图形运动",
      "deck_indices": "54—59",
      "locations": "教材印刷105—114；教参PDF213—228",
      "methods": "轴对称（完全重合与对应点等距）；按方向/距离平移；按中心/方向/角度旋转，常见90°；补全方格图形。"
    },
    {
      "unit": "九 平均数",
      "deck_indices": "60—63",
      "locations": "教材印刷121—130；教参PDF241—261",
      "methods": "平均数反映整体水平；先总后分、移多补少；分段/复式分段统计表；区间不重不漏。"
    },
    {
      "unit": "总复习",
      "deck_indices": "64—69",
      "locations": "教材印刷133起；教参PDF275起",
      "methods": "按本册知识综合复习，仍保持上述年级范围。"
    },
    {
      "unit": "智慧广场 重叠",
      "deck_indices": "70",
      "locations": "教材印刷131—132；教参PDF262—274",
      "methods": "用连线或韦恩图理解重叠；实际数＝两部分之和－重复数，重叠只计一次。"
    }
  ],
