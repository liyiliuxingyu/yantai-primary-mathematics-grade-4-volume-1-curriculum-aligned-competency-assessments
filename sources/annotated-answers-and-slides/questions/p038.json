      "id": "二、5",
      "kind": "choice",
      "question_latex": "下面各组数据，不能组成三角形的是（　）。",
      "options": [
        "A. 6厘米、6厘米、6厘米",
        "B. 3分米、3分米、6分米",
        "C. 9米、7米、8米",
        "D. 12厘米、6厘米、10厘米"
      ],
      "tables": [],
      "diagrams": [],
