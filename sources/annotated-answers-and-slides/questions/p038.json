          "tikz": "\\begin{tikzpicture}[x=.45cm,y=.6cm]\\draw(0,0)--(10,0);\\foreach\\x in{0,...,8}{\\draw(\\x,0)--(\\x+1,1.4)--(\\x+2,0);\\draw(\\x,1.4)--(\\x+1,0)--(\\x+2,1.4);}\\draw(10,0)rectangle(11,1.8);\\end{tikzpicture}",
