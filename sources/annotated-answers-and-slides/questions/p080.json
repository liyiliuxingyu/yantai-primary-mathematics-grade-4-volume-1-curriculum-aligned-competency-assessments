          "name": "p080_venn",
          "tikz": "\\begin{tikzpicture}[x=1cm,y=1cm]\\draw(-1.2,0)ellipse(2 and .8);\\draw(1.2,0)ellipse(2 and .8);\\node at(-1.6,1.15){AI环保创意赛};\\node at(1.6,1.15){低碳编程挑战赛};\\draw[->](0,-1.4)--(0,-.65);\\node[below]at(0,-1.4){两项活动都参加的};\\end{tikzpicture}",
